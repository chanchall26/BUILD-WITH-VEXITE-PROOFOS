# PROOFOS runs with no configuration at all.
#
# With nothing set, every Gemini call is served from deterministic fixtures and
# the interface says so on every page. That is what makes the deployed demo safe
# to hand to a stranger on an unknown network. Add a key and the same code paths
# hit the live API.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini rate limits per key rather than per project, so a demo that needs more
# than a couple of calls a minute can spread the load. Comma-separated. Calls
# rotate across the pool, and a key that is refused steps aside until its
# window clears. Either variable works; both can be set.
GEMINI_API_KEYS=

# Ed25519 signing material, derived by SHA-256 from this string, and separately
# the AES-256-GCM key that seals the calibration answer key.
# Keep it stable: change it and every issued passport stops verifying.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
PROOFOS_SECRET=

# Model overrides.
#
# A free-tier key has NO quota for the pro tier and is refused immediately, so
# the first call of every cold start pays a wasted round trip before falling
# back. If your key is free tier, point the architect at the flash model:
#
#   GEMINI_ARCHITECT_MODEL=gemini-3.8-flash
#
# Rubric design is a little less considered; everything else is identical, and
# the demo stops waiting forty seconds for its opening move.
GEMINI_ARCHITECT_MODEL=
GEMINI_WORKHORSE_MODEL=

# Public origin, used to build did:web and the status list URL. On Vercel this
# is derived automatically from VERCEL_PROJECT_PRODUCTION_URL.
PROOFOS_ORIGIN=

# Override the issuer identifier. Defaults to did:web derived from the origin.
PROOFOS_ISSUER=
